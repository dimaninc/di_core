{
    "name": "dimaninc/di_core",
    "description": "dimaninc core library",
    "version": "0.11.1",
    "keywords": ["baggio"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Petrov",
            "email": "dimaninc@gmail.com"
        }
    ],
    "type": "library",
    "require": {
		"php": ">=8.1",
        "twig/twig": ">=2.11"
    },
	"suggest": {
		"ext-pcntl": "diCore\\Queue: worker timeouts and graceful stop",
		"ext-pdo_pgsql": "diCore\\Queue: the PostgreSQL task queue",
		"minishlink/web-push": "^11, PHP 8.2+ – diCore\\Push\\WebPush: browser Web Push (with symfony/http-client and nyholm/psr7)"
	},
	"require-dev": {
		"phpunit/phpunit": "^11",
		"minishlink/web-push": "^11",
		"symfony/http-client": "^7.3",
		"nyholm/psr7": "^1.8"
    },
	"autoload": {
        "psr-4": {
            "diCore\\": "php/src/diCore"
        }
    }
}
