{
    "name": "dimaninc/di_core",
    "description": "dimaninc core library",
    "version": "0.11.1",
    "keywords": ["baggio"],
    "license": "MIT",
    "authors": [
        {
            "name": "Dmitry Petrov",
            "email": "dimaninc@gmail.com"
        }
    ],
    "type": "library",
    "require": {
		"php": ">=8.1",
        "twig/twig": ">=2.11"
    },
	"suggest": {
		"ext-pcntl": "diCore\\Queue: worker timeouts and graceful stop",
		"ext-pdo_pgsql": "diCore\\Queue: the PostgreSQL task queue"
	},
	"require-dev": {
		"phpunit/phpunit": "^11",
        "phpmailer/phpmailer": "^6.9"
    },
	"autoload": {
        "psr-4": {
            "diCore\\": "php/src/diCore"
        }
    }
}
