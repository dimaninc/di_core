{% import 'admin/_macro/head.html.twig' as head %}

<title>{{ _tech['page_title'] }}</title>
<base href="{{ _tech['html_base'] }}">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">

{# Zoom stays allowed: a dense table or an inline chart is unreadable on a phone
   otherwise. iOS focus-zoom is prevented by 16px fields in parts/inputs.styl #}
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="format-detection" content="telephone=no">

<link rel="icon" type="image/png" href="{{ asset_locations['images'] }}admin/icon.png">

{% for name in jsFiles %}{{ head.js(_context, name) }}{% endfor %}

{% for name in cssFiles %}{{ head.style(_context, name) }}{% endfor %}
